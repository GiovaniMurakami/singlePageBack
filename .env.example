# JWT - RS256 em produção (Base64 ou SSM). HS256 só em desenvolvimento local.
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_SECRET=altere_esta_chave_local
JWT_SSM_PRIVATE_KEY_PARAM=
JWT_SSM_PUBLIC_KEY_PARAM=

PORT=3000
# Separe várias origens com vírgula (front local + Amplify/domínio).
CORS_ORIGIN=http://localhost:5173,https://localhost:5173,https://homolog.singlepage.com.br,https://www.singlepage.com.br,https://singlepage.com.br
FRONTEND_URL=https://homolog.singlepage.com.br
LOG_LEVEL=info
IS_LOCAL=true

DYNAMODB_DATA_TABLE=single-page-local-data
DYNAMODB_DATA_REGION=us-east-1

AWS_S3_BUCKET=singlepage-bucket-images
AWS_S3_REGION=us-east-1

# Stripe live fica só em .env.production (não use em homolog).
# Pro = R$ 9,90/mês · Ultra = R$ 49,90/mês (gere com npm run stripe:setup)

ALARM_NOTIFICATION_EMAIL=giovani.murakami@outlook.com

# Ambientes (não versionados): .env.homolog e .env.production

