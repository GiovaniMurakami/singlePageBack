{
  "name": "single-page-back",
  "version": "0.1.0",
  "description": "API Lambda para construtor de páginas únicas",
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/iniciarServidor.ts",
    "lint": "eslint .",
    "build": "node esbuild.config.js",
    "deploy": "npm run deploy:prod",
    "deploy:dev": "npm run build && serverless deploy --stage dev --region us-east-1",
    "deploy:prod": "npm run build && serverless deploy --stage prod --region us-east-1",
    "test": "npm run test:unit",
    "test:unit": "jest --verbose --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "stripe:setup": "ts-node scripts/configurarStripe.ts",
    "dynamo:setup": "ts-node scripts/criarTabelaLocal.ts",
    "cors:s3": "ts-node scripts/configurarCorsS3.ts"
  },
  "author": "Giovani Murakami",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1023.0",
    "@aws-sdk/client-s3": "^3.1023.0",
    "@aws-sdk/client-ssm": "^3.1022.0",
    "@aws-sdk/s3-request-presigner": "^3.1023.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^10.3.1",
    "serverless-http": "^3.2.0",
    "stripe": "^18.5.0",
    "uuid": "^10.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.6",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.12.0",
    "globals": "^15.11.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.7",
    "serverless": "^4.4.6",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0"
  }
}
